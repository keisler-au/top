# PostgreSQL
POSTGRES_DB=triage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/triage

# HTTP services
API_PORT=8000
OLLAMA_PORT=11434

# Chat model
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Embeddings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBEDDING_BATCH_SIZE=16

# Queue and workers
WORKER_POLL_INTERVAL=2
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_SECONDS=5
QUEUE_RETRY_MAX_SECONDS=300
LOG_LEVEL=INFO

# Topic worker
TOPIC_SIMILAR_LIMIT=5
TOPIC_EXISTING_LIMIT=50

# Theme worker
THEME_WORKER_INTERVAL=2
THEME_CANDIDATE_LIMIT=500
THEME_EXISTING_LIMIT=50
THEME_SIMILARITY_THRESHOLD=0.82
THEME_TOPIC_SIMILARITY_THRESHOLD=0.65
THEME_MIN_GROUP_SIZE=2
